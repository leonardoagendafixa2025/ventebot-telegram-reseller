# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - BOT REVENDEDOR TELEGRAM + VENTEBOT RESELLER API
# Crie seu arquivo .env.local baseado neste modelo. NUNCA envie valores reais ao Git.
# ==============================================================================

# URL base da sua aplicação (usado no webhook do Telegram e redirecionamentos)
APP_BASE_URL=https://seu-dominio.vercel.app

# ------------------------------------------------------------------------------
# SUPABASE (Banco de Dados PostgreSQL, Auth e Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# OBRIGATÓRIO NO SERVIDOR: Nunca exponha ao navegador ou cliente!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# TELEGRAM BOT API
# ------------------------------------------------------------------------------
# Token obtido com @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Nome de usuário do bot (sem o @)
TELEGRAM_BOT_USERNAME=meu_loja_bot
# Token secreto para validação do header X-Telegram-Bot-Api-Secret-Token no Webhook
TELEGRAM_WEBHOOK_SECRET=gerar_uma_string_aleatoria_segura_de_pelo_menos_32_chars
# ID do canal público para transmissão de ofertas e reposição (ex: @canal_loja ou -1001234567890)
TELEGRAM_PUBLIC_CHANNEL_ID=@meu_canal_ofertas

# ------------------------------------------------------------------------------
# VENTEBOT RESELLER API (FORNECEDOR OFICIAL)
# ------------------------------------------------------------------------------
# Chave de Revenda gerada no bot/painel do fornecedor (@storeBatmanBot)
# Enviada no header 'X-Reseller-Key' apenas no backend
VENTEBOT_RESELLER_KEY=vb_reseller_sample_key_here
# Endpoint da API VenteBot (padrão oficial)
VENTEBOT_BASE_URL=https://web-production-1c7b1.up.railway.app

# ------------------------------------------------------------------------------
# SEGURANÇA E INICIALIZAÇÃO ADMINISTRATIVA
# ------------------------------------------------------------------------------
# Chave secreta de bootstrap para registrar com segurança o primeiro superadministrador
ADMIN_BOOTSTRAP_SECRET=chave_secreta_super_forte_para_iniciar_admin
